# Backend runtime
EEG_BACKEND_HOST=127.0.0.1
EEG_BACKEND_PORT=8000

# Realtime EEG source: demo | tcp
EEG_REALTIME_SOURCE=demo
EEG_TCP_HOST=127.0.0.1
EEG_TCP_PORT=12345

# Device output: noop | tcp | http
EEG_DEVICE_MODE=noop
EEG_DEVICE_ID=default-device
EEG_DEVICE_TCP_HOST=127.0.0.1
EEG_DEVICE_TCP_PORT=19001
EEG_DEVICE_HTTP_URL=http://127.0.0.1:19002/device-action
EEG_DEVICE_TIMEOUT_S=2.0

# Frontend
VITE_REALTIME_WS_URL=ws://127.0.0.1:8000/ws/realtime
