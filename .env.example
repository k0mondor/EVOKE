# Backend runtime
EEG_BACKEND_HOST=127.0.0.1
EEG_BACKEND_PORT=8000

# Realtime EEG source: demo | tcp
EEG_REALTIME_SOURCE=demo
EEG_TCP_HOST=127.0.0.1
EEG_TCP_PORT=12345

# Device output: noop | tcp | http | serial
EEG_DEVICE_MODE=serial
EEG_DEVICE_ID=default-device
EEG_DEVICE_TCP_HOST=127.0.0.1
EEG_DEVICE_TCP_PORT=19001
# In tcp mode the backend writes accepted inference codes as plain lines:
# 0 -> left, 1 -> right, 2 -> feet
EEG_DEVICE_HTTP_URL=http://127.0.0.1:19002/device-action
EEG_DEVICE_TIMEOUT_S=2.0

# Serial (Tuya T5 board)
# Connect via USB-UART, send signal code 0/1/2 as ASCII bytes with newline
EEG_DEVICE_SERIAL_PORT=COM3
EEG_DEVICE_SERIAL_BAUDRATE=115200

# Frontend
VITE_REALTIME_WS_URL=ws://127.0.0.1:8000/ws/realtime
